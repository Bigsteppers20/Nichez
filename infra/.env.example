# Local MinIO credentials for infra/docker-compose.yml.
# Copy to infra/.env (gitignored) and change every value. All values here are FAKE.

# Root (admin) account. Use only for the console at http://localhost:9001.
# Never give it to the backend. Password: 8+ characters.
MINIO_ROOT_USER=nichez-root
MINIO_ROOT_PASSWORD=change-me-root-password

# Service user that can only read/write/list/delete objects in the "media" bucket.
# These are what the backend uses as R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY locally.
# Secret: 8+ characters.
MINIO_SERVICE_ACCESS_KEY=nichez-backend
MINIO_SERVICE_SECRET_KEY=change-me-service-secret
