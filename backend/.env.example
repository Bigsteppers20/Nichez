# Backend environment for the LOCAL profile.
# Copy to backend/.env (gitignored) and adjust. Only the local profile reads
# this file; prod reads real environment variables and never imports .env.
#
# Values below match the local stack: `npx supabase status` and
# infra/.env.example. Secrets are FAKE or the Supabase CLI's public local
# defaults. For hosted values see docs/SETUP.md.

# --- Database: local Supabase Postgres (supabase status: DB_URL) ---
DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Auth: how to verify Supabase access tokens ---
# HS256 = shared JWT secret (local CLI default). JWKS = published keys (hosted projects).
# Check: curl http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
#   - "keys" empty  -> keep HS256 and SUPABASE_JWT_SECRET (supabase status: JWT_SECRET)
#   - "keys" listed -> switch AUTH_MODE to JWKS
AUTH_MODE=HS256
# Public, well-known local CLI default. Never use this value anywhere but localhost.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWKS_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Must equal the "iss" claim exactly, no trailing slash.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# --- Supabase Auth (server-to-server, phone OTP) ---
# Base URL without trailing slash. Local CLI: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
# The project's anon (publishable) key, sent as the apikey header. Local: `npx supabase status`.
SUPABASE_ANON_KEY=

# --- Phone OTP limits (defaults shown; all optional) ---
# ISO region codes. Placeholder default: confirm the launch countries.
# AUTH_SMS_ALLOWED_COUNTRIES=NG,GH,KE,ZA,GB,US
# AUTH_SMS_MAX_SENDS_PER_PHONE_PER_HOUR=5
# AUTH_SMS_MAX_SENDS_PER_IP_PER_HOUR=20
# AUTH_SMS_RESEND_COOLDOWN=60s
# AUTH_SMS_CODE_TTL=5m
# AUTH_SMS_MAX_ATTEMPTS=3
# AUTH_SMS_LOCKOUT=30m

# --- Profile ---
# GET /handles/check allowance per signed-in user (optional)
# PROFILE_HANDLE_CHECK_PER_MINUTE=60

# --- Storage: local MinIO (infra/docker-compose.yml) ---
# Endpoint the backend itself calls (HEAD, DELETE).
STORAGE_ENDPOINT=http://localhost:9000
# Host baked into presigned URLs; must be reachable from the client.
# Android emulator: http://10.0.2.2:9000   USB + adb reverse: http://127.0.0.1:9000
# Wi-Fi phone: http://<laptop LAN IP>:9000  (see docs/LOCAL_DEV.md)
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
# The bucket-scoped service user from infra/.env (MINIO_SERVICE_*), never the root user.
STORAGE_ACCESS_KEY=nichez-backend
STORAGE_SECRET_KEY=change-me-service-secret
STORAGE_BUCKET=media

# --- Media URLs ---
# presigned = signed S3 URLs straight to MinIO (local). worker = Cloudflare playback Worker.
MEDIA_URL_PROVIDER=presigned
MEDIA_URL_TTL=15m
# Required only when MEDIA_URL_PROVIDER=worker.
WORKER_BASE_URL=
PLAYBACK_TOKEN_SECRET=

# --- HTTP ---
# Comma-separated exact browser origins (no wildcards). Native apps don't need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
